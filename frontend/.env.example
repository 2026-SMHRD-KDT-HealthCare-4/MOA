# Copy this file to .env.local for local-only settings.
# .env.local is gitignored. Restart Expo after changing any value.

# Optional dev auto-login:
#   elder    -> boot as direct user
#   guardian -> boot as guardian
#   empty    -> normal auth flow
EXPO_PUBLIC_DEV_AUTOLOGIN=

# Family/auth API mode:
#   mock -> local in-browser/in-memory flow for screen testing
#   real -> call FastAPI at EXPO_PUBLIC_API_BASE_URL where endpoints exist
EXPO_PUBLIC_AUTH_API_MODE=mock

# Chat API base URL. OpenAI keys belong in backend/.env, not frontend env files.
EXPO_PUBLIC_OPENAI_CHAT_MODEL=gpt-4o-mini
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Kakao Local REST API key (근처 병원 찾기 — keyword search). Never hardcode in source.
# Use the REST API key from Kakao Developers console (not the JavaScript key).
EXPO_PUBLIC_KAKAO_REST_KEY=
